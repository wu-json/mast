Output demo.gif

Require mast

Set Shell bash
Set FontFamily "JetBrains Mono"
Set FontSize 20
Set LineHeight 1.3
Set Width 1200
Set Height 600
Set Padding 28
Set Margin 36
Set MarginFill "#4c4a63"
Set WindowBar Colorful
Set BorderRadius 10
Set TypingSpeed 90ms
Set Framerate 30
Set Theme { "name": "mast", "black": "#27272a", "red": "#ec847a", "green": "#8ab08e", "yellow": "#e2be80", "blue": "#86a2c7", "magenta": "#a896cc", "cyan": "#7fb4b4", "white": "#d4d4d8", "brightBlack": "#52525b", "brightRed": "#f09a91", "brightGreen": "#a3c4a6", "brightYellow": "#ebcd98", "brightBlue": "#a0b7d6", "brightMagenta": "#bcadd9", "brightCyan": "#9cc7c7", "brightWhite": "#f4f4f5", "background": "#18181b", "foreground": "#e4e4e7", "selection": "#3f3f46", "cursor": "#e4e4e7" }

Hide
Type "source /demo/shell.sh && clear"
Enter
Sleep 500ms
Show

Sleep 800ms
Type "mast"
Sleep 400ms
Enter
Sleep 11s
Screenshot screenshot.png
Sleep 12s
Type "q"
Sleep 1.5s
